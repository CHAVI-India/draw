# DRAW deployment config. Copy to ".env" next to docker-compose.yml and edit.
# Docker Compose loads this file automatically. This is the ONLY file you edit per site.

# ---- Required -----------------------------------------------------------------
# The folder the scanner / PACS drops incoming DICOM studies into. Watched by DRAW.
# This is typically OUTSIDE the deploy folder (e.g. a network share / ingest dir).
WATCH_DIR=/path/to/incoming

# Prebuilt GPU image to pull (registry/name:tag). Leave as draw:gpu to build locally.
DRAW_IMAGE=draw:gpu
# missing = pull only if absent; always = always pull the latest tag.
DRAW_PULL_POLICY=missing

# ---- Optional (sensible defaults; relative paths are inside the deploy folder) --
# Model weights + SQLite database live here (persisted, mounted into the container).
DATA_DIR=./data
# RT-Struct outputs the treatment-planning system picks up.
OUTPUT_DIR=./output
# Rotated, gzip-compressed logs (30-day retention) land here.
LOG_DIR=./logs

# Which GPU to use (single-GPU box: 0).
DRAW_GPU_ID=0
# Log verbosity: INFO (default) or DEBUG for troubleshooting.
DRAW_LOG_LEVEL=INFO
